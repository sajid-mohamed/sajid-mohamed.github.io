    },
    {
      "key": "gold_silver",
      "label": "Gold and silver",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
    },
    {
      "key": "trade_inventory",
      "label": "Trade inventory",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
