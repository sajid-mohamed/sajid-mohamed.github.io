{
  "schema_version": 1,
  "id": "ismaili-default",
  "name": "Shia (Ismaili) Default Rules",
  "madhab": "ismaili",
  "version": "1.0.0",
  "currency": "USD",
  "read_only_default": true,
  "nisab_basis": {
    "mode": "gold",
    "source": "Representative Ismaili-oriented baseline profile"
  },
  "rates": {
    "zakat": 0.025
  },
  "asset_categories": [
    {
      "key": "cash",
      "label": "Cash and bank balances",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
    },
    {
      "key": "gold_silver",
      "label": "Gold and silver",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
    },
    {
      "key": "trade_inventory",
      "label": "Trade inventory",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
    },
    {
      "key": "receivables",
      "label": "Recoverable receivables",
      "enabled": true,
      "rate_key": "zakat",
      "include_in_nisab": true
    }
  ],
  "debts_policy": {
    "deduct_short_term": true,
    "deduct_long_term": false,
    "max_deduction_ratio": 1,
    "notes": "Short-term liabilities are deductible in this default profile."
  },
  "exemptions": [
    "primary_residence",
    "personal_vehicle",
    "personal_use_items"
  ],
  "rounding_policy": {
    "mode": "nearest",
    "precision": 2
  },
  "metadata": {
    "tradition_family": "shia",
    "maintainer": "builtin"
  },
  "references": [
    {
      "title": "The Ismailis: Their History and Doctrines (Daftary)",
      "url": "https://www.cambridge.org/core/books/ismailis/311A7A9E184983E9E748AF062C559A18",
      "id": "ismaili-ref-1"
    },
    {
      "title": "Ismaili Gnosis resource portal",
      "url": "https://ismailignosis.com/",
      "id": "ismaili-ref-2"
    }
  ],
  "principles_scope": {
    "reviewed_against_references": true,
    "implemented": [
      "nisab_threshold_basis",
      "zakat_rate_2_5_percent",
      "eligible_assets_screening",
      "debt_deduction_policy",
      "exempt_personal_use_assets",
      "rounding_method",
      "receivables_treatment"
    ],
    "not_implemented": [
      "hawl_lunar_year"
    ],
    "notes": "This profile encodes quantitative calculation settings, but does not model all textual fiqh conditions; hawl lifecycle handling is expected at application/workflow level."
  },
  "automation_policy": {
    "mode": "manual",
    "unresolved_rule_policy": "warn"
  }
}
